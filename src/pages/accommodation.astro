---
import BaseLayout from '../layouts/BaseLayout.astro';
const rooms = [
  {name:'Standard Double Suite',text:'A welcoming room for two, with the comfort and character of the Manor.'},
  {name:'Deluxe Double Suite',text:'A thoughtfully furnished double room for a relaxed Karoo stay.'},
  {name:'Superior Queen Suite',text:'A queen-bed option for couples or solo travellers.'},
  {name:'Deluxe Twin Suite',text:'Twin beds, with bed configuration subject to availability.'},
  {name:'Self-Catering Family Suite',text:'A family option listed for up to two adults and two children. Confirm details before booking.'}
];
---
<BaseLayout title="Accommodation | Moonlight Manor" description="Explore guest room options at Moonlight Manor, Victoria West.">
  <main><section class="page-hero"><div class="wrap"><span class="eyebrow">Stay a little longer</span><h1>Rooms with<br/><em>heritage character.</em></h1><p class="muted">Comfortable accommodation in the heart of Victoria West.</p></div></section>
    <section class="section"><div class="wrap"><div class="content"><h2>Find the right space for your stay.</h2><p class="muted">Public accommodation listings describe a range of double, queen, twin and self-catering family room options. Room names and availability can change, so please confirm details directly when enquiring.</p></div><div class="room-grid">{rooms.map((room,i)=><article class="room-card"><div class="room-photo" style={`background-image:url('${["https://cf.bstatic.com/xdata/images/hotel/max500/913920740.jpg?k=abb145100515b3267a9b60556953755a38a9c495602dcb14c4a58282a2a132c2&o=","https://cf.bstatic.com/xdata/images/hotel/max500/913929013.jpg?k=d05f46e3e5aa130bcbe14266cfba6187c2bdeda23147f57c6a2b75f62196c217&o=","https://cf.bstatic.com/xdata/images/hotel/max500/913919422.jpg?k=28e19584c5a23fdad2c3fe7bf263ba5a1343cdd1e82a5583bd447933da2678ec&o="][i%3]}')`}></div><div class="room-info"><h3>{room.name}</h3><p>{room.text}</p><a href="/contact/">Ask about this room →</a></div></article>)}</div></div></section>
    <section class="cta"><div class="wrap cta-row"><div><span class="eyebrow">Need help choosing?</span><h2>Tell us what you need.</h2></div><a class="btn" href="/contact/">Make an enquiry</a></div></section>
  </main>
</BaseLayout>