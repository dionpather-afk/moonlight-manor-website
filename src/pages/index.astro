---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <main>
    <section class="hero">
      <div class="wrap hero-inner">
        <span class="eyebrow">A Karoo heritage guesthouse · Victoria West</span>
        <h1>A little piece of<br/><em>Karoo history.</em></h1>
        <p>Slow down, settle in and experience the warmth of a historic Victorian home in the heart of the Great Karoo.</p>
        <a class="btn" href="/contact/">Plan your stay</a>
        <div class="hero-note">A welcoming pause on your Karoo journey</div>
      </div>
    </section>
    <section class="section">
      <div class="wrap intro-grid">
        <div class="intro-art" role="img" aria-label="Moonlight Manor veranda and garden"></div>
        <div class="intro-copy">
          <span class="eyebrow">Welcome to Moonlight Manor</span>
          <h2>History in the details.<br/><em>Warmth in every welcome.</em></h2>
          <p>Set in the quiet Upper Karoo town of Victoria West, Moonlight Manor is a late-1800s Victorian home with original character, thoughtful touches and a relaxed guesthouse feel.</p>
          <p>High ceilings, Oregon floors, sash windows and a welcoming veranda tell the story of a house with a past — ready to become part of your journey.</p>
          <a class="btn btn-outline" href="/our-story/">Discover our story</a>
          <div class="stats"><div class="stat"><strong>1890s</strong><span>Heritage character</span></div><div class="stat"><strong>Karoo</strong><span>Wide-open country</span></div></div>
        </div>
      </div>
    </section>
    <section class="section dark">
      <div class="wrap">
        <span class="eyebrow">A stay with character</span><h2>Make yourself at home.</h2>
        <p class="muted" style="max-width:620px">Comfortable rooms, a peaceful garden and the simple pleasure of a warm welcome after a day on the road.</p>
        <div class="feature-grid">
          <article class="feature"><span class="number">01</span><h3>Rest easy</h3><p>Thoughtfully furnished guest rooms, en-suite bathrooms and comforts for a restful stop in the Karoo.</p></article>
          <article class="feature"><span class="number">02</span><h3>Room to breathe</h3><p>Enjoy the veranda and garden, with the quiet character of a historic Victorian home.</p></article>
          <article class="feature"><span class="number">03</span><h3>Find your outdoors</h3><p>Explore the Moonlight Hill hiking trails and the landscapes surrounding Victoria West.</p></article>
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <div class="center"><span class="eyebrow">Find your room</span><h2>A comfortable place to pause.</h2><p class="muted">A selection of guest rooms and a self-catering family option.</p></div>
        <div class="room-grid">
          <article class="room-card"><div class="room-photo"></div><div class="room-info"><h3>Double Suites</h3><p>Comfortable accommodation for couples or solo travellers.</p><a href="/accommodation/">Explore accommodation →</a></div></article>
          <article class="room-card"><div class="room-photo"></div><div class="room-info"><h3>Twin & Queen Rooms</h3><p>Flexible room options for a restful Karoo stay.</p><a href="/accommodation/">Explore accommodation →</a></div></article>
          <article class="room-card"><div class="room-photo"></div><div class="room-info"><h3>Family Suite</h3><p>A self-catering option for families, subject to confirmation.</p><a href="/accommodation/">Explore accommodation →</a></div></article>
        </div>
      </div>
    </section>
    <section class="section" style="background:var(--ivory)">
      <div class="wrap center"><span class="eyebrow">The Upper Karoo</span><p class="quote">“A place to pause, take in the stillness and enjoy the character of the Karoo.”</p><p class="muted">Discover Victoria West and the landscape beyond the garden gate.</p><a class="btn btn-outline" href="/experiences/">Explore the area</a></div>
    </section>
    <section class="cta"><div class="wrap cta-row"><div><span class="eyebrow">Your Karoo stay starts here</span><h2>We would love to welcome you.</h2></div><a class="btn" href="/contact/">Enquire about a stay</a></div></section>
  </main>
</BaseLayout>