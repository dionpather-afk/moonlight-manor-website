---
const {
  title = "Moonlight Manor | A little piece of Karoo history",
  description = "Discover Moonlight Manor, a historic Karoo guesthouse in Victoria West, Northern Cape."
} = Astro.props;
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#282722" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
    <slot name="head" />
    <style is:global>
      :root{--ink:#282722;--ivory:#F2EBDD;--bronze:#A47C4D;--stone:#77715F;--paper:#fbf8f1;--line:rgba(40,39,34,.16)}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.65}a{color:inherit}img{display:block;max-width:100%}
      .wrap{width:min(1160px,calc(100% - 48px));margin:auto}.eyebrow{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--bronze);font-weight:600}.serif,h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:400;line-height:1.12}h1{font-size:clamp(3rem,7vw,6.4rem);margin:.35em 0}h2{font-size:clamp(2.2rem,4vw,4rem);margin:.2em 0 .45em}h3{font-size:1.65rem}
      .btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 23px;background:var(--bronze);color:#fff;text-decoration:none;letter-spacing:.06em;text-transform:uppercase;font-size:.72rem;font-weight:600;transition:.2s}.btn:hover{background:var(--ink);transform:translateY(-2px)}.btn-outline{background:transparent;border:1px solid var(--bronze);color:var(--ink)}.section{padding:100px 0}.muted{color:var(--stone)}.center{text-align:center}.site-header{position:absolute;z-index:5;top:0;left:0;width:100%;color:white;border-bottom:1px solid rgba(255,255,255,.24)}.nav{height:92px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-family:'Playfair Display',serif;font-size:1.45rem;letter-spacing:.04em;text-decoration:none}.brand small{display:block;font-family:'DM Sans',sans-serif;font-size:.56rem;letter-spacing:.3em;text-transform:uppercase;text-align:center}.navlinks{display:flex;gap:25px;align-items:center}.navlinks a{text-decoration:none;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase}.navlinks a:hover{color:var(--ivory)}.menu-toggle{display:none;background:none;border:1px solid rgba(255,255,255,.6);color:white;padding:8px 12px}
      .hero{min-height:780px;display:flex;align-items:end;position:relative;color:white;background:linear-gradient(90deg,rgba(20,19,16,.76),rgba(20,19,16,.12)),linear-gradient(0deg,rgba(20,19,16,.48),transparent 65%),url('/images/moonlight-manor-hero.jpg') center/cover;background-color:#4b493f}.hero-inner{padding:190px 0 105px}.hero h1{max-width:850px}.hero p{max-width:560px;font-size:1.08rem;color:rgba(255,255,255,.86);margin:0 0 30px}.hero-note{display:flex;gap:18px;align-items:center;margin-top:36px;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ivory)}.hero-note:before{content:'';width:48px;height:1px;background:var(--bronze)}
      .intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}.intro-art{min-height:520px;background:linear-gradient(0deg,rgba(40,39,34,.12),rgba(40,39,34,.02)),url('/images/moonlight-manor-verandah.jpg') center/cover;background-color:#d7cbb6}.intro-copy p{color:var(--stone);max-width:520px}.stats{display:flex;gap:42px;margin-top:32px}.stat strong{display:block;font:2rem 'Playfair Display',serif;color:var(--bronze)}.stat span{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;color:var(--stone)}
      .dark{background:var(--ink);color:var(--ivory)}.dark .muted{color:#c2b9a8}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:42px}.feature{padding:30px;border:1px solid rgba(242,235,221,.2)}.feature .number{font:1.6rem 'Playfair Display',serif;color:var(--bronze)}.feature h3{margin:15px 0 8px}.feature p{font-size:.92rem;color:#c2b9a8}
      .room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:40px}.room-card{background:#fff}.room-photo{height:250px;background:#d6c8b3 center/cover}.room-card:nth-child(1) .room-photo{background-image:url('/images/moonlight-manor-room-1.jpg')}.room-card:nth-child(2) .room-photo{background-image:url('/images/moonlight-manor-room-2.jpg')}.room-card:nth-child(3) .room-photo{background-image:url('/images/moonlight-manor-family-suite.jpg')}.room-info{padding:25px}.room-info p{color:var(--stone);font-size:.9rem}.room-info a{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;color:var(--bronze);text-decoration:none}
      .quote{font:clamp(1.7rem,3vw,2.7rem) 'Playfair Display',serif;max-width:850px;margin:25px auto}.cta{background:var(--ivory);padding:76px 0}.cta-row{display:flex;justify-content:space-between;align-items:center;gap:30px}.site-footer{background:#201f1b;color:var(--ivory);padding:60px 0 28px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:50px}.site-footer p,.site-footer a{color:#c2b9a8;font-size:.88rem}.site-footer a{display:block;text-decoration:none;margin:7px 0}.copyright{border-top:1px solid rgba(242,235,221,.18);margin-top:42px;padding-top:20px;font-size:.72rem;color:#a9a08f}
      .page-hero{padding:190px 0 90px;background:var(--ink);color:var(--ivory)}.page-hero h1{font-size:clamp(3rem,6vw,5.2rem)}.content{max-width:820px;margin:auto}.content p{color:var(--stone)}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.gallery-tile{min-height:260px;background:#d5c8b3 center/cover}.gallery-tile:nth-child(1){background-image:url('/images/moonlight-manor-gallery-1.jpg')}.gallery-tile:nth-child(2){background-image:url('/images/moonlight-manor-gallery-2.jpg')}.gallery-tile:nth-child(3){background-image:url('/images/moonlight-manor-gallery-3.jpg')}.gallery-tile:nth-child(4){background-image:url('/images/moonlight-manor-gallery-4.jpg')}.gallery-tile:nth-child(5){background-image:url('/images/moonlight-manor-gallery-5.jpg')}.gallery-tile:nth-child(6){background-image:url('/images/moonlight-manor-gallery-6.jpg')}
      .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:55px}.map-frame{width:100%;height:420px;border:0;filter:grayscale(1)}.contact-details p{color:var(--stone)}.contact-details a{color:var(--bronze)}.mobile-book{display:none}
      @media(max-width:760px){.wrap{width:min(100% - 34px,600px)}.nav{height:78px}.navlinks{display:none;position:absolute;top:78px;left:0;width:100%;padding:22px;background:var(--ink);flex-direction:column;align-items:flex-start}.navlinks.open{display:flex}.menu-toggle{display:block}.hero{min-height:680px}.hero-inner{padding:160px 0 90px}.section{padding:70px 0}.intro-grid,.contact-grid{grid-template-columns:1fr;gap:35px}.intro-art{min-height:350px}.feature-grid,.room-grid{grid-template-columns:1fr}.gallery-grid{grid-template-columns:1fr 1fr}.gallery-tile{min-height:190px}.stats{gap:20px}.cta-row{display:block}.cta-row .btn{margin-top:20px}.footer-grid{grid-template-columns:1fr;gap:25px}.mobile-book{display:block;position:fixed;z-index:8;bottom:0;left:0;right:0;text-align:center;padding:14px;background:var(--bronze);color:white;text-decoration:none;text-transform:uppercase;letter-spacing:.1em;font-size:.76rem}.site-footer{padding-bottom:90px}}
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/">MOONLIGHT MANOR<small>Victoria West · Karoo</small></a>
        <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">Menu</button>
        <nav class="navlinks" aria-label="Main navigation">
          <a href="/">Home</a><a href="/our-story/">Our Story</a><a href="/accommodation/">Stay</a><a href="/experiences/">Explore</a><a href="/gallery/">Gallery</a><a href="/contact/">Contact</a>
          <a class="btn" href="/contact/">Enquire</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div><a class="brand" href="/">MOONLIGHT MANOR<small>Victoria West · Karoo</small></a><p>A little piece of Karoo history.<br/>11 Brinkman Street, Victoria West, Northern Cape.</p></div>
          <div><span class="eyebrow">Discover</span><a href="/our-story/">Our Story</a><a href="/accommodation/">Accommodation</a><a href="/experiences/">Experiences</a><a href="/gallery/">Gallery</a></div>
          <div><span class="eyebrow">Get in touch</span><a href="/contact/">Contact & Booking</a><a href="https://www.booking.com/hotel/za/moonlight-manor.html" target="_blank" rel="noreferrer">Booking.com</a><a href="https://www.airbnb.co.za/rooms/8135981" target="_blank" rel="noreferrer">Airbnb</a></div>
        </div>
        <div class="copyright">© {new Date().getFullYear()} Moonlight Manor. Website preview prepared for discussion.</div>
      </div>
    </footer>
    <a class="mobile-book" href="/contact/">Enquire about a stay</a>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.navlinks');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>